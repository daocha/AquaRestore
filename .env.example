# Copy to .env (gitignored). With AQUARESTORE_DEV_UPDATE_HOST set, debug builds update over your LAN
# from scripts/serve-dev-update.sh. Use this computer's LAN address; it only goes into the debug APK.
AQUARESTORE_DEV_UPDATE_HOST=192.168.1.10
AQUARESTORE_DEV_UPDATE_PORT=8765

# Apple App Store / TestFlight signing (optional for Android-only releases).
# Uncomment and fill these in .env. The scripts also accept scripts/.env.
# Existing exported variables take priority. The .p8 file must exist on this machine.
# DEVELOPMENT_TEAM=YOURTEAMID
# ASC_KEY_PATH="$HOME/.apple-signing/AuthKey_YOURKEYID.p8"
# ASC_KEY_ID=YOURKEYID
# ASC_ISSUER_ID=YOUR_ISSUER_UUID
# Leave all three ASC_* settings unset to use the account signed into Xcode instead.

# Batch features (read by Android Gradle and iOS Xcode builds, including Debug).
# Empty backend URL disables the entire referral campaign and all referral UI.
# A nonempty backend URL locks both batch features and shows Unlock Code in Developer tools.
# Unlock codes and consumption limits live only in the backend SQLite database.
# Empty URL makes both features available and hides Unlock Code.
AQUARESTORE_REFERRAL_BACKEND_URL=
# Use HTTPS in production. Debug permits HTTP for local testing; see docs/REFERRALS.md.

# Debug referral authentication: use the same value as backend AQUARESTORE_DEBUG_TOKEN.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Included only in Debug builds; authenticates requests only to the separate debug campaign.
# This is NOT an unlock code. It never grants batch access or bypasses code/usage checks.
AQUARESTORE_REFERRAL_DEBUG_TOKEN=
# Android production verification uses Key Attestation; no Google Cloud credentials/project are needed.

# Keep token for ordinary Debug testing. Choose platform only for explicit real-proof testing.
# Platform mode never falls back to the debug token; requires provider setup and supported hardware.
AQUARESTORE_REFERRAL_DEBUG_VERIFICATION=token
