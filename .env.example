# Copy to .env (gitignored). With AQUARESTORE_DEV_UPDATE_HOST set, debug builds update over your LAN
# from scripts/serve-dev-update.sh. Use this computer's LAN address; it only goes into the debug APK.
AQUARESTORE_DEV_UPDATE_HOST=192.168.1.10
AQUARESTORE_DEV_UPDATE_PORT=8765

# Apple App Store / TestFlight signing (optional for Android-only releases).
# Uncomment and fill these in .env. The scripts also accept scripts/.env.
# Existing exported variables take priority. The .p8 file must exist on this machine.
# DEVELOPMENT_TEAM=YOURTEAMID
# ASC_KEY_PATH="$HOME/.apple-signing/AuthKey_YOURKEYID.p8"
# ASC_KEY_ID=YOURKEYID
# ASC_ISSUER_ID=YOUR_ISSUER_UUID
# Leave all three ASC_* settings unset to use the account signed into Xcode instead.
